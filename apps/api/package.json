  "description": "Public Application API (ARCHITECTURE.md §3): REST endpoints, orchestration; never touches provider SDKs or sandboxes",
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
