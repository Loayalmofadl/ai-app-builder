# Forge Platform — environment template
# Copy to .env for local development. ALL VALUES HERE ARE PLACEHOLDERS.
# Real secrets come from your secret manager; NEVER commit filled-in copies.
# The canonical schema (which vars are required per app) lives in packages/shared/src/env.ts.

# ---- Core ----
NODE_ENV=development
FORGE_ENV=local
LOG_LEVEL=info

# ---- Database (PostgreSQL via docker compose dev stack) ----
DATABASE_URL=postgresql://forge:CHANGE_ME@localhost:5432/forge_dev
DATABASE_POOL_MAX=10

# ---- Redis (cache + BullMQ queues) ----
REDIS_URL=redis://localhost:6379

# ---- Ports (dev defaults; see infra/docker/compose.dev.yml) ----
API_PORT=3001
GATEWAY_PORT=3002
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# ---- Service-to-service auth (shared secret for HMAC request signing; M2 rotates to per-service keys) ----
SERVICE_TOKEN_SECRET=CHANGE_ME_MIN_32_RANDOM_BYTES

# ---- AI provider keys (READ ONLY BY apps/gateway adapters; keep unset elsewhere) ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
QWEN_API_KEY=

# ---- Object storage (MinIO in dev; S3-shaped interface, ADR-011 — adapter lands M2+) ----
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET_BLOBS=forge-blobs-dev
STORAGE_ACCESS_KEY_ID=CHANGE_ME
STORAGE_SECRET_ACCESS_KEY=CHANGE_ME

# ---- Auth (ADR-007 resolved at M1 exit; production wiring is M2) ----
AUTH_SESSION_SECRET=CHANGE_ME_MIN_32_RANDOM_BYTES
AUTH_OAUTH_GOOGLE_CLIENT_ID=
AUTH_OAUTH_GOOGLE_CLIENT_SECRET=
AUTH_OAUTH_GITHUB_CLIENT_ID=
AUTH_OAUTH_GITHUB_CLIENT_SECRET=

# ---- Sandbox / preview (implemented M5; vars reserved, validated only when driver set) ----
SANDBOX_RUNTIME_DRIVER=docker
PREVIEW_DOMAIN=localhost.previews.example
PREVIEW_SIGNING_SECRET=CHANGE_ME_MIN_32_RANDOM_BYTES

# ---- Billing (vendor pending P-1/Stripe assumption; implemented M6) ----
BILLING_PROVIDER=stripe-placeholder
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Email (Mailpit in dev) ----
SMTP_URL=smtp://localhost:1025
MAIL_FROM=no-reply@forge.local

# ---- Observability ----
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
METRICS_ENABLED=true
