{
  "name": "@forge/config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared tooling configuration: TypeScript/ESLint/Prettier/Vitest presets + forbidden-provider-imports enforcement rule (CONTRIBUTING.md §6)",
  "license": "UNLICENSED",
  "type": "commonjs",
  "exports": {
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./tsconfig/nestjs.json": "./tsconfig/nestjs.json",
    "./tsconfig/nextjs.json": "./tsconfig/nextjs.json",
    "./eslint/base": "./eslint/base.mjs",
    "./eslint/forbidden-imports": "./eslint/forbidden-imports.eslint.config.mjs",
    "./prettier": "./prettier/base.json",
    "./vitest": "./vitest/base.mjs",
    "./rules/forbidden-provider-imports": "./eslint/forbidden-provider-imports.cjs"
  },
  "files": ["tsconfig", "eslint", "prettier", "vitest"],
  "scripts": {
    "typecheck": "node -e \"process.exit(0)\"",
    "lint": "node -e \"process.exit(0)\"",
    "test": "vitest run --config eslint/self-test.vitest.config.mjs",
    "build": "node -e \"process.exit(0)\""
  },
  "dependencies": {
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "eslint": "^9.39.0",
    "typescript-eslint": "^8.46.0"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  }
}
